{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SolutionsConfig",
  "type": "object",
  "required": [
    "version",
    "solutions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "solutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "additionalProperties": true,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  }
}
