# AlzerBooking Core Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alzer_booking_core
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alzer_booking_core
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20

# Ephemeral Cache / Redis (Optional UX Hold Layer)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
